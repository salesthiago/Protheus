{
  "datasets": [
    {
      "name": "est_kpi",
      "displayName": "Estoque - KPIs",
      "queryLines": [
        "SELECT * FROM quebec.gold.vw_est_kpi WHERE filial = :filial"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Todas"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "est_abc",
      "displayName": "Estoque - curva ABC",
      "queryLines": [
        "SELECT * FROM quebec.gold.vw_est_abc WHERE filial = :filial ORDER BY classe"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
