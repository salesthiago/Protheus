    },
    {
      "name": "est_aj",
      "displayName": "Estoque - ajustes",
      "queryLines": [
        "SELECT * FROM quebec.gold.vw_est_ajustes_mes WHERE filial = :filial ORDER BY mes"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Todas"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "est_par",
      "displayName": "Estoque - itens parados",
      "queryLines": [
        "SELECT * FROM quebec.gold.vw_est_parados WHERE (:filial = 'Todas' OR filial = :filial) ORDER BY valor DESC LIMIT 200"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Todas"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "filiais",
      "displayName": "Filiais (opções do filtro)",
      "queryLines": [
        "SELECT filial FROM (SELECT 'Todas' AS filial UNION SELECT filial FROM quebec.gold.vw_est_kpi UNION SELECT filial FROM quebec.gold.vw_est_abc UNION SELECT filial FROM quebec.gold.vw_est_fechamentos UNION SELECT filial FROM quebec.gold.vw_est_ajustes_mes UNION SELECT filial FROM quebec.gold.vw_est_parados) WHERE filial IS NOT NULL ORDER BY CASE WHEN filial = 'Todas' THEN 0 ELSE 1 END, filial"
      ]
    }
  ],
