                  "value": "Todas"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "est_fech",
      "displayName": "Estoque - fechamentos",
      "queryLines": [
        "SELECT * FROM quebec.gold.vw_est_fechamentos WHERE filial = :filial ORDER BY mes"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
