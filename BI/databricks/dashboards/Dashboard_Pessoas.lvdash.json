          "keyword": "data_fim",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-12-31T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "centro_custo",
          "keyword": "centro_custo",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Todos"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "rh_mov",
      "displayName": "Pessoas - movimento",
      "queryLines": [
        "SELECT mes, 'Admissões' AS tipo, sum(ADM) AS pessoas FROM quebec.gold.vw_rh_adm_dem WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) AND mes BETWEEN date_trunc('MONTH', :data_inicio) AND :data_fim GROUP BY mes UNION ALL SELECT mes, 'Demissões' AS tipo, sum(DEM) AS pessoas FROM quebec.gold.vw_rh_adm_dem WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) AND mes BETWEEN date_trunc('MONTH', :data_inicio) AND :data_fim GROUP BY mes ORDER BY mes"
