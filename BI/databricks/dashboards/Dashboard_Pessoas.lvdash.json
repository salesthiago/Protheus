{
  "datasets": [
    {
      "name": "rh_kpi",
      "displayName": "Pessoas - KPIs",
      "queryLines": [
        "WITH q AS (SELECT sum(N) AS headcount, sum(CASE WHEN SIT = 'A' THEN N ELSE 0 END) AS afastados, sum(CASE WHEN SIT = 'F' THEN N ELSE 0 END) AS em_ferias FROM quebec.gold.vw_rh_quadro WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo)), d AS (SELECT sum(ADM) AS adm_periodo, sum(DEM) AS dem_periodo FROM quebec.gold.vw_rh_adm_dem WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) AND mes BETWEEN date_trunc('MONTH', :data_inicio) AND :data_fim) SELECT q.*, d.*, try_divide(d.dem_periodo, q.headcount) AS turnover_periodo, try_divide(q.afastados, q.headcount) AS pct_afastados FROM q CROSS JOIN d"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Todas"
                }
              ]
            }
          }
        },
        {
