          "keyword": "data_inicio",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-01-01T00:00:00.000"
                }
              ]
            }
          }
        },
        {
