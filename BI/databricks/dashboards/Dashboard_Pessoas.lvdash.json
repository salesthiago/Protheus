    {
      "name": "med_mes",
      "displayName": "Saúde - por mês",
      "queryLines": [
        "WITH a AS (SELECT date_trunc('MONTH', dt_inicio) AS mes, count(*) AS atestados, sum(coalesce(datediff(dt_fim, dt_inicio) + 1, 1)) AS dias_atestado FROM quebec.gold.vw_med_atestados WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) AND dt_inicio BETWEEN :data_inicio AND :data_fim GROUP BY 1), c AS (SELECT date_trunc('MONTH', dt_acidente) AS mes, count(*) AS acidentes, count_if(com_afastamento) AS acidentes_com_afastamento FROM quebec.gold.vw_med_acidentes WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) AND dt_acidente BETWEEN :data_inicio AND :data_fim GROUP BY 1) SELECT coalesce(a.mes, c.mes) AS mes, coalesce(atestados, 0) AS atestados, coalesce(dias_atestado, 0) AS dias_atestado, coalesce(acidentes, 0) AS acidentes, coalesce(acidentes_com_afastamento, 0) AS acidentes_com_afastamento FROM a FULL OUTER JOIN c ON a.mes = c.mes ORDER BY mes"
      ],
      "parameters": [
        {
          "displayName": "filial",
          "keyword": "filial",
          "dataType": "STRING",
          "defaultSelection": {
