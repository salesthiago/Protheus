      "displayName": "Pessoas - quadro por CC",
      "queryLines": [
        "SELECT centro_custo, sum(N) AS pessoas, sum(CASE WHEN SIT = 'A' THEN N ELSE 0 END) AS afastados FROM quebec.gold.vw_rh_quadro WHERE (:filial = 'Todas' OR filial = :filial) AND (:centro_custo = 'Todos' OR centro_custo = :centro_custo) GROUP BY centro_custo ORDER BY pessoas DESC LIMIT 15"
