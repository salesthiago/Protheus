    {
      "name": "rh_ccs",
      "displayName": "Centros de custo (opções do filtro)",
      "queryLines": [
        "SELECT centro_custo FROM (SELECT 'Todos' AS centro_custo UNION SELECT centro_custo FROM quebec.gold.vw_rh_quadro UNION SELECT centro_custo FROM quebec.gold.vw_rh_adm_dem UNION SELECT centro_custo FROM quebec.gold.vw_rh_folha UNION SELECT centro_custo FROM quebec.gold.vw_med_atestados UNION SELECT centro_custo FROM quebec.gold.vw_med_acidentes) WHERE centro_custo IS NOT NULL ORDER BY CASE WHEN centro_custo = 'Todos' THEN 0 ELSE 1 END, centro_custo"
      ]
    },
    {
      "name": "filiais",
      "displayName": "Filiais (opções do filtro)",
      "queryLines": [
        "SELECT filial FROM (SELECT 'Todas' AS filial UNION SELECT filial FROM quebec.gold.vw_rh_quadro UNION SELECT filial FROM quebec.gold.vw_rh_adm_dem UNION SELECT filial FROM quebec.gold.vw_rh_folha UNION SELECT filial FROM quebec.gold.vw_med_atestados UNION SELECT filial FROM quebec.gold.vw_med_acidentes) WHERE filial IS NOT NULL ORDER BY CASE WHEN filial = 'Todas' THEN 0 ELSE 1 END, filial"
      ]
    }
