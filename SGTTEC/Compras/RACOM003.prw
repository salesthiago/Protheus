		oPrint:Say(nLinha,aPosicao[1]+160	,if(aVlrTotal[1] = 0, "", AllTrim(TransForm(aVlrTotal[1],'@E 99,999,999.99'))),oFont09,,,,1)
		oPrint:Say(nLinha,aPosicao[2]+160	,if(aVlrTotal[2] = 0, "", AllTrim(TransForm(aVlrTotal[2],'@E 99,999,999.99'))),oFont09,,,,1)
		oPrint:Say(nLinha,aPosicao[3]+160	,if(aVlrTotal[3] = 0, "", AllTrim(TransForm(aVlrTotal[3],'@E 99,999,999.99'))),oFont09,,,,1)
		oPrint:Say(nLinha,aPosicao[4]+160	,if(aVlrTotal[4] = 0, "", AllTrim(TransForm(aVlrTotal[4],'@E 99,999,999.99'))),oFont09,,,,1)
		oPrint:Say(nLinha,aPosicao[5]+160	,if(aVlrTotal[5] = 0, "", AllTrim(TransForm(aVlrTotal[5],'@E 99,999,999.99'))),oFont09,,,,1)

		oPrint:Say(nLinha,aPosicao[6]+160	, TransForm(nTotGer,'@E 99,999,999.99')										  ,oFont09,,,,1)

		//xVerPag()

		//?????????????????????????
		//?Imprime TOTAL DE I.P.I. ?
		//??????????????????????????
		
		If	( lImpPrc ) .and. ( _nValIpi > 0 )
			oPrint:Line(nLinha,1390,nLinha+80,1390)
			oPrint:Line(nLinha,1840,nLinha+80,1840)
