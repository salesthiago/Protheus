		oPrint:Line(nLinha,2490,nLinha+80,2490) 
		oPrint:Line(nLinha,2790,nLinha+80,2790) 

		oPrint:Say(nLinha+10,0940,'SUB TOTAL ',oFont12)
		If	( lImpPrc )
			//oPrint:Say(nLinha+10,2260,TransForm(_nValMerc + _nValIPI - _nValDesc + _nTotAcr	+ _nTotSeg + _nTotFre + _nTotIcmsRet,'@E 9,999,999.99'),oFont13,,,,1)
		EndIf
		nLinha += 60

		oPrint:Line(nLinha,1290,nLinha+80,1290) 
		oPrint:Line(nLinha,1590,nLinha+80,1590)
		oPrint:Line(nLinha,1890,nLinha+80,1890) 
		oPrint:Line(nLinha,2190,nLinha+80,2190) 
		oPrint:Line(nLinha,2490,nLinha+80,2490) 
		oPrint:Line(nLinha,2790,nLinha+80,2790) 

		oPrint:Say(nLinha,0940,OemToAnsi('FRETE'),oFont12)

		oPrint:Say(nLinha,aPosicao[1]+10 /*1310*/,if(len(aVlrFrete)>=1,aTipFrete[1]+transform(aVlrFrete[1],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[2]+10 /*1610*/,if(len(aVlrFrete)>=2,aTipFrete[2]+transform(aVlrFrete[2],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[3]+10 /*1910*/,if(len(aVlrFrete)>=3,aTipFrete[3]+transform(aVlrFrete[3],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[4]+10 /*2210*/,if(len(aVlrFrete)>=4,aTipFrete[4]+transform(aVlrFrete[4],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[5]+10 /*2510*/,if(len(aVlrFrete)>=5,aTipFrete[5]+transform(aVlrFrete[5],"@E 999,999.99"),""),oFont09)	

		oPrint:Say(nLinha,aPosicao[6]+160	, TransForm(nTotFre,'@E 99,999,999.99')								,oFont09,,,,1)

