		oPrint:Say(nLinha,aPosicao[2]+25 /*1610*/,if(len(aVlrDesc)>=2,transform(aVlrDesc[2],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[3]+25 /*1910*/,if(len(aVlrDesc)>=3,transform(aVlrDesc[3],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[4]+25 /*2210*/,if(len(aVlrDesc)>=4,transform(aVlrDesc[4],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[5]+25 /*2510*/,if(len(aVlrDesc)>=5,transform(aVlrDesc[5],"@E 999,999.99"),""),oFont09)	

		oPrint:Say(nLinha,aPosicao[6]+160	, TransForm(nTOtDes,'@E 99,999,999.99')								,oFont09,,,,1)

		nLinha += 60

		oPrint:Line(nLinha,1290,nLinha+80,1290) 
		oPrint:Line(nLinha,1590,nLinha+80,1590)
		oPrint:Line(nLinha,1890,nLinha+80,1890) 
		oPrint:Line(nLinha,2190,nLinha+80,2190) 
		oPrint:Line(nLinha,2490,nLinha+80,2490) 
		oPrint:Line(nLinha,2790,nLinha+80,2790) 

		oPrint:Say(nLinha,0940,OemToAnsi('IPI'),oFont12)

		oPrint:Say(nLinha,aPosicao[1]+25 /*1310*/,if(len(aVlrIPI)>=1,transform(aVlrIPI[1],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[2]+25 /*1610*/,if(len(aVlrIPI)>=2,transform(aVlrIPI[2],"@E 999,999.99"),""),oFont09)
		oPrint:Say(nLinha,aPosicao[3]+25 /*1910*/,if(len(aVlrIPI)>=3,transform(aVlrIPI[3],"@E 999,999.99"),""),oFont09)
