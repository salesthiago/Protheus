???Programa  ? LC13R    ?Autor ?Pedro Neto? Data ?  28/07/14   ???
????????????????????????????????????????????????????????????????????????????
???Desc.     ? MAPA DE COTA??O (Emissao em formato Grafico)               ???
????????????????????????????????????????????????????????????????????????????
???Uso       ? Compras                                                    ???
????????????????????????????????????????????????????????????????????????????
???DATA      ? ANALISTA ? MOTIVO                                          ???
????????????????????????????????????????????????????????????????????????????
???          ?          ?                                                 ???
????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
*/

// alterar o parametro MV_PCOMPRA e colocar PEDGRF para substituir a impressão padrão.

User Function RACOM003(cChamada)
	Private	lEnd		:= .f.
	Private cFilCot		:= SC8->C8_FILIAL
	Private	cNumCot  	:= SC8->C8_NUM
	Private lHasPed	:= .T.	// Indica se ha um pedido de compra (SC7) vinculado a cotacao atual

	aAreaSC8	:= SC8->(GetArea())
	aAreaSA2	:= SA2->(GetArea())

	if cChamada = "C"
		cFilCot	:= SC8->C8_FILIAL
		cNumCot := SC8->C8_NUM
	elseif cChamada = "P"
		cFilCot	:= SC7->C7_FILIAL
		cNumCot := SC7->C7_NUMCOT

		SC8->(DbSetOrder(1))
		SC8->(DbSeek(cFilCot+cNumCot))
	elseif cChamada = "M"
		// Chamada a partir do menu (sem tela de origem), com intervalo de cotacao De/Ate
		If !Pergunte("RACOM03",.T.) .or. Empty(mv_par01) .or. Empty(mv_par02)
			RestArea(aAreaSC8)
			RestArea(aAreaSA2)
			Return
		EndIf

		cFilCot := xFilial("SC8")

		cAliasCot := GetNextAlias()
		cQueryCot := "SELECT DISTINCT SC8.C8_NUM FROM "+retSqlName("SC8")+" SC8 "
		cQueryCot += "WHERE SC8.D_E_L_E_T_ = ' ' AND SC8.C8_FILIAL = '"+cFilCot+"' "
		cQueryCot += "AND SC8.C8_NUM BETWEEN '"+mv_par01+"' AND '"+mv_par02+"' "
		cQueryCot += "ORDER BY SC8.C8_NUM "
		dbUseArea(.T.,"TOPCONN",TcGenQry(,,cQueryCot),cAliasCot,.T.,.T.)

		If (cAliasCot)->(Eof())
			Aviso("Atenção","Nenhuma cotação encontrada no intervalo informado.",{"OK"})
		Else
			Do While (cAliasCot)->(!Eof())
				cNumCot := (cAliasCot)->C8_NUM

				SC8->(DbSetOrder(1))
				If SC8->(DbSeek(cFilCot+cNumCot))
					lHasPed := xAcharPed(cFilCot,cNumCot)
					Processa({ |lEnd| xPrintRel(),'Gerando o relatório.'}, OemToAnsi('Cotação '+cNumCot+'...'))
				EndIf

				(cAliasCot)->(DbSkip())
			Enddo
		EndIf
		(cAliasCot)->(DbCloseArea())
	else
    	SC7->(DbSetOrder(1))
    	SC7->(DbSeek(xFilial("SC7")+substr(SCR->CR_NUM,1,6)+"0001"))

		cFilCot	:= SC7->C7_FILIAL
		cNumCot := SC7->C7_NUMCOT

		SC8->(DbSetOrder(1))
		SC8->(DbSeek(cFilCot+cNumCot))

	endif

	If cChamada != "M"
		Processa({ |lEnd| xPrintRel(),'Gerando o relatório.'}, OemToAnsi('Aguarde...'))
	EndIf

	//?????????????????????????????????????????????
	//?Restaura a area anterior ao processamento. !?
	//??????????????????????????????????????????????
	RestArea(aAreaSC8)
	RestArea(aAreaSA2)
Return

/*
?????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
????????????????????????????????????????????????????????????????????????????
???Programa  ? xPrintRel?Autor ?Luis Henrique Robusto? Data ?  10/09/04   ???
????????????????????????????????????????????????????????????????????????????
???Desc.     ? Imprime a Duplicata...                                     ???
????????????????????????????????????????????????????????????????????????????
???Uso       ? Funcao Principal                                           ???
????????????????????????????????????????????????????????????????????????????
???DATA      ? ANALISTA ? MOTIVO                                          ???
????????????????????????????????????????????????????????????????????????????
???          ?          ?                                                 ???
????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
?????????????????????????????????????????????????????????????????????????????
*/

Static Function xPrintRel()
Local cAliasTop		:= GetNextAlias()
Local nIt 			:= 0
Local aCondPg		:= {}
Local nPosFor		:= 0
Local nItFor		:= 0
Private	oPrint		:= TMSPrinter():New('MAPA DE COTAÇÃO'),;
		oBrush		:= TBrush():New(,4),;
		oPen		:= TPen():New(0,5,CLR_BLACK),;
		cFileLogo	:= GetSrvProfString('Startpath','') + 'LOGORECH02' + '.BMP',;
		oFont07		:= TFont():New('Courier New',07,07,,.F.,,,,.T.,.F.),;
		oFont08		:= TFont():New('Courier New',08,08,,.F.,,,,.T.,.F.),;
		oFont09		:= TFont():New('Tahoma',09,09,,.F.,,,,.T.,.F.),;
		oFont10		:= TFont():New('Tahoma',10,10,,.F.,,,,.T.,.F.),;
		oFont10n	:= TFont():New('Courier New',10,10,,.T.,,,,.T.,.F.),;
		oFont11		:= TFont():New('Tahoma',11,11,,.F.,,,,.T.,.F.),;
		oFont11n	:= TFont():New('Tahoma',11,11,,.T.,,,,.T.,.F.),;
		oFont12		:= TFont():New('Tahoma',09,09,,.T.,,,,.T.,.F.),;
		oFont12n	:= TFont():New('Tahoma',09,09,,.F.,,,,.T.,.F.),;
		oFont13		:= TFont():New('Tahoma',13,13,,.T.,,,,.T.,.F.),;
		oFont14		:= TFont():New('Tahoma',14,14,,.T.,,,,.T.,.F.),;
		oFont15		:= TFont():New('Courier New',15,15,,.T.,,,,.T.,.F.),;
		oFont18		:= TFont():New('Arial',18,18,,.T.,,,,.T.,.T.),;
		oFont16		:= TFont():New('Arial',14,14,,.T.,,,,.T.,.F.),;
		oFont20		:= TFont():New('Arial',20,20,,.F.,,,,.T.,.F.),;
		oFont22		:= TFont():New('Arial',22,22,,.T.,,,,.T.,.F.)   

	oPrint:SetLandscape()
	oPrint:Setup()
	
	//cFileLogo := "lgrlpc" + cEmpAnt + ".bmp"
	cFileLogo := "lgrl" + cEmpAnt+ ".bmp"

	If !File(cFileLogo)
		cFileLogo := "lgrl" + cEmpAnt + cFilAnt + ".bmp"
	EndIf

Private	lFlag		:= .T.,;	// Controla a impressao do fornecedor
		nLinha		:= 0,;		// Controla a linha por extenso
		nLinFim		:= 0,;		// Linha final para montar a caixa dos itens
		lPrintDesTab:= .f.,;	// Imprime a Descricao da tabela (a cada nova pagina)
		cRepres		:= Space(80)

Private	_nQtdReg	:= 0,;		// Numero de registros para intruir a regua
		_nValMerc 	:= 0,;		// Valor das mercadorias
		_nValIPI	:= 0,;		// Valor do I.P.I.
		_nValDesc	:= 0,;		// Valor de Desconto
		_nTotAcr	:= 0,;		// Valor total de acrescimo
		_nTotSeg	:= 0,;		// Valor de Seguro
		_nTotFre	:= 0,;		// Valor de Frete
		_nTotIcmsRet:= 0		// Valor do ICMS Retido
        
Private cStartPath             //Pedro Neto

Private	lImpPrc		:= .t.	// Imprime os Precos ?
	
		DbSelectArea('SA2')
		SA2->(DbSetOrder(1))
		if	!SA2->(DbSeek(xFilial('SA2')+SC8->(C8_FORNECE+C8_LOJA)))
			Help('',1,'REGNOIS')
			Return .F.
		endIf
		
		cQuery := "SELECT SC8.C8_FILIAL, SC8.C8_NUM, SC8.C8_ITEM, SC8.C8_NUMPRO, SC8.C8_PRODUTO, SC8.C8_UM, SC8.C8_QUANT, SC8.C8_PRECO, "
		cQuery += "SC8.C8_TOTAL, SC8.C8_FORNECE, SC8.C8_LOJA, SC8.C8_FORNOME, SC8.C8_CONTATO, SC8.C8_EMISSAO, SC8.C8_VALFRE, SC8.C8_ALIIPI, SC8.C8_BASEIPI, "
		cQuery += "SC8.C8_TOTFRE, SC8.C8_COND, SC8.C8_TPFRETE, SC8.C8_DESPESA, SC8.C8_VALIPI, SC8.C8_VLDESC, SC8.C8_NUMPED, SC8.C8_ITEMPED, SC8.C8_XCOMPL, "
		cQuery += "SC8.C8_NUMSC, SC8.C8_ITEMSC "
		cQuery += "FROM "+retSqlName("SC8") + " SC8 "
		cQuery += "WHERE SC8.D_E_L_E_T_ = ' '  "
		cQuery += "AND SC8.C8_FILIAL = '"+cFilCot+"' AND SC8.C8_NUM = '"+cNumCot+"' "
		cQuery += "AND SC8.C8_SITUAC <> '5' "	// Oculta fornecedor Desqualificado no Mapa de Cotacao (Novo Fluxo de Compras)
		cQuery += "ORDER BY SC8.C8_FILIAL, SC8.C8_NUM, SC8.C8_ITEM, SC8.C8_FORNECE, SC8.C8_LOJA "
    	dbUseArea(.T.,"TOPCONN",TcGenQry(,,cQuery),cAliasTop,.T.,.T.)

		aProduto	:= {}
		aFornece	:= {}
		aFone 		:= {}
		aDados		:= {}
		aCondPg		:= {}
		aTipFrete	:= {}
		aPosicao	:= {1410, 1715, 2020, 2325, 2630, 2935 }
		aVlrTotal	:= {0,0,0,0,0}
		aVlrProd 	:= {}	// Valor total de mercadoria por fornecedor (todos os itens), base para o rateio do frete por item
		aVlrFrete 	:= {}
		aVlrDesc 	:= {}
		aVlrIPI 	:= {}

		(cAliasTop)->(DbGoTop())
		do While (cAliasTop)->(!Eof())

			if nIt <= 5
				nPosFor := Ascan(aFornece , (cAliasTOP)->C8_FORNOME	)
				if nPosFor = 0
					Aadd(aFornece 	, (cAliasTOP)->C8_FORNOME				)
					Aadd(aFone 		, Posicione("SA2",1,xFilial("SA2")+ (cAliasTOP)->(C8_FORNECE+C8_LOJA),"A2_TEL"))
					Aadd(aCondPg  	, (cAliasTOP)->C8_COND   				)
					Aadd(aTipFrete	, (cAliasTOP)->C8_TPFRETE				)
					Aadd(aVlrFrete	, (cAliasTOP)->(C8_VALFRE+C8_DESPESA) )
					Aadd(aVlrDesc 	, (cAliasTOP)->C8_VLDESC 				)
					Aadd(aVlrIPI  	, (cAliasTOP)->C8_VALIPI 				)
					Aadd(aVlrProd 	, (cAliasTOP)->C8_TOTAL 				)
					nIt++
				else
					aVlrFrete[nPosFor] 	+= (cAliasTOP)->(C8_VALFRE+C8_DESPESA)
					aVlrDesc[nPosFor]	+= (cAliasTOP)->C8_VLDESC
					aVlrIPI[nPosFor]	+= (cAliasTOP)->C8_VALIPI
					aVlrProd[nPosFor]	+= (cAliasTOP)->C8_TOTAL
				endif
			endif

			(cAliasTop)->(DbSkip())
		enddo

		nTotGer 	 := 0
		nTotFre 	 := 0
		nTOtDes 	 := 0
		nTotIPI 	 := 0
		nValTotGeral := 0	// Total do fornecedor de menor preco (mercadoria+frete+IPI-desconto), acumulado item a item
		aVlrTotFor	 := {}	// Total por fornecedor das 5 colunas (mercadoria+frete+IPI-desconto)

		(cAliasTop)->(DbGoTop())
		do While (cAliasTop)->(!Eof())

			if nLinha == 0 
				oPrint:StartPage()
				
				xCabec()
				nLinha := 500
				lPrintDesTab := .T.

				lFlag := .F.
			elseif nLinha >= 1850
					oPrint:endPage()					
					
					oPrint:StartPage()
					xCabec()
					nLinha := 500
					lPrintDesTab := .T.
			endif

			If	( lPrintDesTab )
				nLinha += 70				

				oPrint:Line(nLinha,1290,nLinha,2790)

				oPrint:Line(nLinha,1290,nLinha+10+40*5,1290) 
				oPrint:Line(nLinha,1590,nLinha+10+40*5,1590)
				oPrint:Line(nLinha,1890,nLinha+10+40*5,1890) 
				oPrint:Line(nLinha,2190,nLinha+10+40*5,2190) 
				oPrint:Line(nLinha,2490,nLinha+10+40*5,2490) 
				oPrint:Line(nLinha,2790,nLinha+10+40*5,2790) 

				oPrint:Say(nLinha,1300,OemToAnsi(if(len(aFornece)>=1,Substr(aFornece[1],1,12),""))	,oFont11)
				oPrint:Say(nLinha,1600,OemToAnsi(if(len(aFornece)>=2,Substr(aFornece[2],1,12),""))	,oFont11)
				oPrint:Say(nLinha,1900,OemToAnsi(if(len(aFornece)>=3,Substr(aFornece[3],1,12),""))	,oFont11)
				oPrint:Say(nLinha,2200,OemToAnsi(if(len(aFornece)>=4,Substr(aFornece[4],1,12),""))	,oFont11)
				oPrint:Say(nLinha,2500,OemToAnsi(if(len(aFornece)>=5,Substr(aFornece[5],1,12),""))	,oFont11)
				oPrint:Say(nLinha,2800,OemToAnsi("  FORNECEDOR  ")							  		,oFont11)
				nLinha += 40

				oPrint:Say(nLinha,1300,OemToAnsi(if(len(aFornece)>=1,Substr(aFornece[1],13,12),""))	,oFont11)
				oPrint:Say(nLinha,1600,OemToAnsi(if(len(aFornece)>=2,Substr(aFornece[2],13,12),""))	,oFont11)
				oPrint:Say(nLinha,1900,OemToAnsi(if(len(aFornece)>=3,Substr(aFornece[3],13,12),""))	,oFont11)
				oPrint:Say(nLinha,2200,OemToAnsi(if(len(aFornece)>=4,Substr(aFornece[4],13,12),""))	,oFont11)
				oPrint:Say(nLinha,2500,OemToAnsi(if(len(aFornece)>=5,Substr(aFornece[5],13,12),""))	,oFont11)
				oPrint:Say(nLinha,2800,OemToAnsi("  SELECIONADO  ")							  		,oFont11)

				nLinha += 40

				oPrint:Say(nLinha,1300,OemToAnsi(if(len(aFone)>=1,Substr(aFone[1],1,12),""))	,oFont11)
				oPrint:Say(nLinha,1600,OemToAnsi(if(len(aFone)>=2,Substr(aFone[2],1,12),""))	,oFont11)
				oPrint:Say(nLinha,1900,OemToAnsi(if(len(aFone)>=3,Substr(aFone[3],1,12),""))	,oFont11)
				oPrint:Say(nLinha,2200,OemToAnsi(if(len(aFone)>=4,Substr(aFone[4],1,12),""))	,oFont11)
				oPrint:Say(nLinha,2500,OemToAnsi(if(len(aFone)>=5,Substr(aFone[5],1,12),""))	,oFont11)
				
				nLinha += 70

				oPrint:Say(nLinha,0015,OemToAnsi('It')			,oFont12)
				oPrint:Say(nLinha,0075,'Código'		,oFont12)
				oPrint:Say(nLinha,0225,'Descrição'	,oFont12)
				oPrint:Say(nLinha,1135,OemToAnsi('Un')			,oFont12)
				oPrint:Say(nLinha,1210,OemToAnsi('Qtde')		,oFont12)

				oPrint:Say(nLinha,1300,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,1450,OemToAnsi('Vlr Total')	,oFont12)

				oPrint:Say(nLinha,1600,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,1750,OemToAnsi('Vlr Total')	,oFont12)

				oPrint:Say(nLinha,1900,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,2050,OemToAnsi('Vlr Total')	,oFont12)

				oPrint:Say(nLinha,2200,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,2350,OemToAnsi('Vlr Total')	,oFont12)

				oPrint:Say(nLinha,2500,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,2650,OemToAnsi('Vlr Total')	,oFont12)

				oPrint:Say(nLinha,2815,OemToAnsi('Vlr.Unit.')	,oFont12)
				oPrint:Say(nLinha,2965,OemToAnsi('Vlr Total')	,oFont12)
				oPrint:Say(nLinha,3110,OemToAnsi("Pos")			,oFont12)

				lPrintDesTab := .F.
				nLinha += 60
				oPrint:Line(nLinha,0010,nLinha,3080)
			EndIf

			nLinha += 20	// Espacamento entre a linha do item e a borda superior

			cPlaca := ""
			cDesc  := alltrim(Posicione("SB1",1,xFilial("SB1")+(cAliasTop)->C8_PRODUTO,"B1_DESC"))
			cNumOS := substr(Posicione("SC1",1,(cAliasTOP)->(C8_FILIAL+C8_NUMSC+C8_ITEMSC),"C1_OP"),1,6)
			cPlaca := Posicione("STJ",1,(cAliasTOP)->C8_FILIAL+cNumOS,"TJ_CODBEM")

			// Quebra a descricao em 2 linhas para nao invadir as colunas de Un/Qtde
			cDescL1 := cDesc
			cDescL2 := ""
			if Len(cDesc) > 59
				nQuebraD := RAt(" ",Substr(cDesc,1,59))
				if nQuebraD == 0
					nQuebraD := 59
				endif
				cDescL1 := Substr(cDesc,1,nQuebraD)
				cDescL2 := Substr(LTrim(Substr(cDesc,nQuebraD+1)),1,59)
			endif

			oPrint:Say(nLinha,0015,Right((cAliasTop)->C8_ITEM,2),oFont09)
			oPrint:Say(nLinha,0075,(cAliasTop)->C8_PRODUTO,oFont09)
			oPrint:Say(nLinha,0225,cDescL1,oFont08)

			oPrint:Say(nLinha,1135,(cAliasTop)->C8_UM										,oFont09)
			oPrint:Say(nLinha,1275,AllTrim(TransForm((cAliasTop)->C8_QUANT,'@E 99,999.9'))	,oFont09,,,,1)

			cChave 		:= (cAliasTOP)->(C8_FILIAL+C8_NUM+C8_ITEM)
			nCol 		:= 1410
			nMenor 		:= 999999999
			nMenorLiq	:= 999999999	// Menor preco liquido (ja descontado), usado para definir o vencedor
			nTotal		:= 0
			nPosMenor 	:= 1
			cProduto 	:= (cAliasTOP)->C8_PRODUTO
			cFilRef 	:= (cAliasTOP)->C8_FILIAL
			nQtdItem	:= (cAliasTOP)->C8_QUANT
			nFrete		:= 0
			nVlrDesc	:= 0	// Desconto por unidade, usado para exibir o valor liquido
			nVlrDescTot	:= 0	// Desconto total do item (unidade x quantidade), usado para somar o total geral
			nvlrIPI		:= 0
			cForFech	:= ""

			do while (cAliasTOP)->(!Eof()) .and. (cAliasTOP)->(C8_FILIAL+C8_NUM+C8_ITEM) == cChave

				nPos := Ascan(aFornece,(cAliasTOP)->C8_FORNOME)
				if nPos >= 1 .and. nPos <= 5
					oPrint:Line(nLinha,1290,nLinha+80,1290)
					oPrint:Line(nLinha,1590,nLinha+80,1590)
					oPrint:Line(nLinha,1890,nLinha+80,1890)
					oPrint:Line(nLinha,2190,nLinha+80,2190)
					oPrint:Line(nLinha,2490,nLinha+80,2490)
					oPrint:Line(nLinha,2790,nLinha+80,2790)

					oPrint:Say(nLinha   , aPosicao[nPos]	, AllTrim(TransForm((cAliasTop)->C8_PRECO,'@E  9,999,999.99'))	,oFont09,,,,1)
					oPrint:Say(nLinha   , aPosicao[nPos]+160, AllTrim(TransForm((cAliasTop)->C8_TOTAL,'@E 99,999,999.99'))	,oFont09,,,,1)

					// Valor com desconto do fornecedor, em fonte menor, abaixo do valor unitario/total cheio
					// C8_VLDESC ja e o total do desconto do item; o desconto por unidade e C8_VLDESC/C8_QUANT
					If (cAliasTop)->C8_VLDESC <> 0
						nUnitLiq  := (cAliasTop)->C8_PRECO - if((cAliasTop)->C8_QUANT > 0, (cAliasTop)->C8_VLDESC / (cAliasTop)->C8_QUANT, 0)
						nTotalLiq := (cAliasTop)->C8_TOTAL - (cAliasTop)->C8_VLDESC
						oPrint:Say(nLinha+40   , aPosicao[nPos]	, AllTrim(TransForm(nUnitLiq,'@E  9,999,999.99'))	,oFont07,,,,1)
						oPrint:Say(nLinha+40   , aPosicao[nPos]+160, AllTrim(TransForm(nTotalLiq,'@E 99,999,999.99'))	,oFont07,,,,1)
					EndIf

					oPrint:Say(nLinha+80, aPosicao[nPos]-110, substr((cAliasTOP)->C8_XCOMPL,1,20)                           ,oFont09)

					aVlrTotal[nPos] += (cAliasTop)->C8_TOTAL

					// O frete e cotado pelo fornecedor para a cotacao toda (aVlrFrete[nPos]), nao por item.
					// Por isso ele e rateado entre os itens na proporcao do valor de mercadoria de cada item
					// (C8_TOTAL do item / aVlrProd[nPos] = total de mercadoria do fornecedor) e so entao composto ao custo do item.
					nFreteItem := if(aVlrProd[nPos] > 0, aVlrFrete[nPos] * (cAliasTop)->C8_TOTAL / aVlrProd[nPos], 0)

					// Custo total liquido = total da mercadoria menos o desconto mais o frete rateado do item, para comparar o custo efetivo entre fornecedores
					nPrecoLiq := (cAliasTop)->C8_TOTAL - (cAliasTop)->C8_VLDESC + nFreteItem

					if nPrecoLiq < nMenorLiq .and. (cAliasTop)->C8_PRECO > 0
						nMenorLiq	:= nPrecoLiq
						nPosMenor 	:= nPos
						nMenor 		:= (cAliasTop)->C8_PRECO
						nTotal		:= (cAliasTop)->C8_TOTAL
						nFrete      := nFreteItem
						nVlrDesc 	:= if((cAliasTop)->C8_QUANT > 0, (cAliasTop)->C8_VLDESC / (cAliasTop)->C8_QUANT, 0)
						nVlrDescTot	:= (cAliasTop)->C8_VLDESC
						nvlrIPI 	:= (cAliasTop)->C8_VALIPI
						if empty((cAliasTop)->C8_NUMPED)
							cForFech := ""
						else
							cForFech	:=  Posicione("SA2",1,XFILIAL("SA2") +; 
											Posicione("SC7",1,(cAliasTOP)->(C8_FILIAL+C8_NUMPED+C8_ITEMPED),"C7_FORNECE")+;
											Posicione("SC7",1,(cAliasTOP)->(C8_FILIAL+C8_NUMPED+C8_ITEMPED),"C7_LOJA"),"A2_NOME")
						endif
					endif
				endif
				(cAliasTOP)->(DbSkip())
			enddo

			If !Empty(cDescL2)
				oPrint:Say(nLinha+40,0225,cDescL2,oFont08)
			EndIf

			oPrint:Say(nLinha,aPosicao[6]		, TransForm(nMenor,'@E 9,999,999.99' )									,oFont09,,,,1)
			oPrint:Say(nLinha,aPosicao[6]+160	, TransForm(nTotal,'@E 99,999,999.99')									,oFont09,,,,1)

			// Valor com desconto do fornecedor selecionado, em fonte menor, abaixo do valor unitario/total cheio
			If nVlrDesc <> 0
				nMenorLiq2 := nMenor - nVlrDesc
				nTotalLiq2 := nMenorLiq2 * nQtdItem
				oPrint:Say(nLinha+40,aPosicao[6]		, TransForm(nMenorLiq2,'@E 9,999,999.99' )						,oFont07,,,,1)
				oPrint:Say(nLinha+40,aPosicao[6]+160	, TransForm(nTotalLiq2,'@E 99,999,999.99')						,oFont07,,,,1)
			EndIf

			oPrint:Say(nLinha, 3280				, substr(aFornece[nPosMenor],1,10)										,oFont08,,,,1)
			oPrint:Say(nLinha+80, 3280			, substr(cForFech,1,10)													,oFont08,,,,1)
			nTotGer		+= nTotal
			nTotFre 	+= nFrete
			nTOtDes		+= nVlrDescTot
			nTotIPI 	+= nvlrIPI

			oPrint:Line(nLinha+35,aPosicao[nPosMenor]-70,nLinha+35,aPosicao[nPosMenor])

			nLinha += 80
			cUltVlr := U_fultVlr(cProduto, cFilRef)+ if(!Empty(cPlaca)," Aplic da SC: "+cPlaca,"")
			nQtdLin := 0
			do while !Empty(cUltVlr) .and. nQtdLin < 3
				if Len(cUltVlr) <= 80
					cLinAtu := cUltVlr
					cUltVlr := ""
				else
					nQuebra := RAt(" ",Substr(cUltVlr,1,80))
					if nQuebra == 0
						nQuebra := 80
					endif
					cLinAtu := Substr(cUltVlr,1,nQuebra)
					cUltVlr := LTrim(Substr(cUltVlr,nQuebra+1))
				endif
				oPrint:say(nLinha,0075,cLinAtu,oFont08)
				nQtdLin++
				if !Empty(cUltVlr) .and. nQtdLin < 3
					nLinha += 40
				endif
			enddo
			nLinha += 40

			oPrint:Line(nLinha,0010,nLinha,3080)

			IncProc()

		Enddo

		// Total real do fornecedor de menor preco, considerando o acumulado de todos os itens (nao apenas o ultimo)
		nValTotGeral := nTotGer + nTotFre + nTotIPI - nTOtDes

		// Total por fornecedor (colunas 1 a 5): mercadoria + frete + IPI - desconto
		aVlrTotFor := {0,0,0,0,0}
		For nItFor := 1 To 5
			If nItFor <= Len(aVlrFrete)
				aVlrTotFor[nItFor] := aVlrTotal[nItFor] + aVlrFrete[nItFor] + aVlrIPI[nItFor] - aVlrDesc[nItFor]
			Else
				aVlrTotFor[nItFor] := aVlrTotal[nItFor]
			EndIf
		Next nItFor

		oPrint:Line(nLinha,1290,nLinha+40,1290)
