			oPrint:Say(nLinha+10,2260,TransForm(_nValIpi,'@E 9,999,999.99'),oFont13,,,,1)
			nLinha += 80
			oPrint:Line(nLinha,1390,nLinha,2300)
		EndIf

		xVerPag()
		
		//??????????????????????????
		//?Imprime TOTAL DE DESCONTO?
		//???????????????????????????
		
		If	( lImpPrc ) .and. ( _nValDesc > 0 )
