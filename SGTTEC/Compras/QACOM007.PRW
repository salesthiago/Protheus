#Include "Totvs.ch"
#Include "FwMvcDef.ch"

User Function QACOM007()

Private oBrowse 	:= FwMBrowse():New()				//Variavel de Browse 

//Alias do Browse
oBrowse:SetAlias('SZB')
//Descrição da Parte Superior Esquerda do Browse
oBrowse:SetDescripton("Cadastro de Preços de Compras") 

//Adiciona Legenda
//oBrowse:AddLegend( "Empty(Z3_DTACLA)" , "RED"	, "NF Não Classificada")
//oBrowse:AddLegend( "!Empty(Z3_DTACLA)", "GREEN", "NF Classificado")

//Habilita os Botões Ambiente e WalkThru
oBrowse:SetWalkThru(.T.)

//Desabilita os Detalhes da parte inferior do Browse
oBrowse:DisableDetails()
          	
//Ativa o Browse
oBrowse:Activate()

Return

Static Function MenuDef()
Local aMenu :=	{}
	
ADD OPTION aMenu TITLE 'Pesquisar'      ACTION 'PesqBrw'       		OPERATION 1 ACCESS 0
ADD OPTION aMenu TITLE 'Visualizar'     ACTION 'VIEWDEF.QACOM007'	OPERATION 2 ACCESS 0
ADD OPTION aMenu TITLE 'Incluir'        ACTION 'VIEWDEF.QACOM007' 	OPERATION 3 ACCESS 0
ADD OPTION aMenu TITLE 'Alterar'        ACTION 'VIEWDEF.QACOM007' 	OPERATION 4 ACCESS 0
ADD OPTION aMenu TITLE 'Excluir'        ACTION 'VIEWDEF.QACOM007' 	OPERATION 5 ACCESS 0
ADD OPTION aMenu TITLE 'Imprimir'       ACTION 'VIEWDEF.QACOM007'	OPERATION 6 ACCESS 0
	
Return(aMenu)

Static Function ModelDef()
//Retorna a Estrutura do Alias passado como Parametro (1=Model,2=View)
Local oStruct	:=	FWFormStruct(1,"SZB") 
Local oModel

//Instancia do Objeto de Modelo de Dados
oModel	:=	MpFormModel():New('QACOM07A',/*Pré-Validação*/ ,/*Pos-Validacao*/;
                                       ,/*Commit*/,/*Cancel*/)

//Adiciona um modelo de Formulario de Cadastro Similar à Enchoice ou Msmget
oModel:AddFields('SZB_MASTER', /*cOwner*/, oStruct, /*bPreValidacao*/;
                       , /*bPosValidacao*/, /*bCarga*/ )

//Adiciona Descricao do Modelo de Dados
oModel:SetDescription( 'Cadastro de Preços de Compras' )

//Adiciona Descricao do Componente do Modelo de Dados      
oModel:GetModel( 'SZB_MASTER' ):SetDescription( 'Cadastro de Preços de Compras' )

//A Chave Primária é obrigatória, caso não tenha defina um array vazio
oModel:SetPrimaryKey({'ZB_FILIAL','ZB_COD','ZB_CC'})  

Return(oModel)

/* VIEW */
Static Function ViewDef()
Local oStruct	:=	FWFormStruct(2,"SZB") 	//Retorna a Estrutura do Alias passado
                                            // como Parametro (1=Model,2=View)
Local oModel	:=	FwLoadModel('QACOM007')	//Retorna o Objeto do Modelo de Dados 
Local oView		:=	FwFormView():New()      //Instancia do Objeto de Visualização

//Define o Modelo sobre qual a Visualizacao sera utilizada
oView:SetModel(oModel)	

//oView:SetFieldAction("Z3_DOC" 	, {|oView, oModel| fCompDOC(oView, oModel)})

//Vincula o Objeto visual de Cadastro com o modelo 
oView:AddField( 'SZB_VIEW', oStruct, 'SZB_MASTER')

//Define o Preenchimento da Janela
oView:CreateHorizontalBox( 'ID_BOX_ALL'  , 100 )

// Relaciona o ID da View com o "box" para exibicao
oView:SetOwnerView( 'SZB_VIEW', 'ID_BOX_ALL' )

Return(oView)                       

