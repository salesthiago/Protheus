Function Matr020()

Local cReport	:= "MATR020"	//Nome do Programa
Local cAlias	:= "SA1"		//Alias da tabela
Local cTitle	:= STR0016      //"Listagem de Clientes"
Local cDesc		:= STR0017      //"Este relatório apresenta uma relação dos Clientes cadastrados."
