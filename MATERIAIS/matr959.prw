Function Matr959()

Local cReport   := "MATR959"    //Nome do Programa
Local cAlias    := "SF7"        //Alias da tabela
Local cTitle	:= STR0001		//Exceções Fiscais
Local cDesc     := STR0002     	//Este relatório apresenta uma relação das Exce‡äes Fiscais cadastradas.
Local lInd		:= .T.			//Retorna Indice SIX

If cPaisLoc == "BRA"
	cAlias    := "SF7"
Else
	cAlias    := "SFF"
Endif

MPReport(cReport,cAlias,cTitle,cDesc,,lInd)

Return
